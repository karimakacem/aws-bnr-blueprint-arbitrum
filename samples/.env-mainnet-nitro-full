##############################################################
# Arbitrum One - Arbitrum Nitro (Full Node)
# Chain ID 42161 - settles to Ethereum mainnet
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="arbitrum"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="mainnet"
CLIENT_CONFIG="nitro-v3.12.1-full.yml"

# Instance Configuration
# r6i.2xlarge: 8 vCPU, 64 GB RAM = the Arbitrum docs' full-node minimum
# (64 GB RAM, 8 cores). Use r6i.4xlarge (16 vCPU, 128 GB, the docs'
# "recommended") for heavy RPC load, or r7g.2xlarge with CPU_TYPE="ARM_64".
INSTANCE_TYPE="r6i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
# The 2026-10-05 pruned snapshot is 2,668,663,418,880 bytes (2485 GiB, 5 parts).
# Nitro's restore holds parts + joined archive, then archive + database, so it
# needs ~2x the snapshot free: 4971 GiB, plus headroom for chain growth
# (~50 GB/month between the 09-23 and 10-05 snapshots) -> 5500 GiB.
# 250 ms blocks: max out gp3 IOPS/throughput (also speeds the restore).
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="5500"
DATA_VOL_1_IOPS="16000"
DATA_VOL_1_THROUGHPUT="1000"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
# SNAPSHOT_ENABLED is the framework's own S3 snapshot restore; Arbitrum
# snapshots are published by Offchain Labs and restored by Nitro itself.
SNAPSHOT_ENABLED="false"
# By default Nitro restores the latest pruned snapshot (--init.latest=pruned),
# so nothing needs setting here. To pin a specific one, set the snapshot
# DIRECTORY URL (trailing slash) from
# https://snapshot-explorer.arbitrum.io/?chain=Arbitrum+One
# ARBITRUM_SNAPSHOT_URL="https://snapshot.arbitrum.foundation/arb1/<YYYY-MM-DD-id>/"

# Arbitrum Custom Configuration
# Ethereum MAINNET L1 endpoints (execution RPC + beacon). Free, no-key
# defaults; the node is configured to tolerate free-endpoint rate limits
# during catch-up (Nitro retries 429s with backoff and throttles its L1 inbox
# reads - see node.sh). The RPC must serve eth_getLogs for L1 blocks back to
# the snapshot's date: after a restore, Nitro replays the inbox from there.
# publicnode's free RPC refuses that ("Archive requests require a personal
# token"), so it is NOT usable here. Free, keyless alternative that serves old
# logs: https://rpc.mevblocker.io
ARBITRUM_L1_RPC_URL="https://mainnet.gateway.tenderly.co"
ARBITRUM_L1_BEACON_URL="https://ethereum-beacon-api.publicnode.com"

# Node ports (optional - defaults shown)
# ARBITRUM_RPC_PORT="8547"
# ARBITRUM_WS_PORT="8548"
# ARBITRUM_METRICS_PORT="6070"
