##############################################################
# Arbitrum Nova - Arbitrum Nitro (Full Node)
# Chain ID 42170 - AnyTrust chain, settles to Ethereum mainnet
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="arbitrum"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="nova"
CLIENT_CONFIG="nitro-v3.12.1-full.yml"

# Instance Configuration
# r6i.2xlarge: 8 vCPU, 64 GB RAM (Arbitrum docs' full-node minimum).
INSTANCE_TYPE="r6i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
# The 2026-09-08 pruned snapshot is 624,665,384,960 bytes (582 GiB, 2 parts).
# 2x for the restore = 1164 GiB -> 1500 GiB with growth headroom.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="1500"
DATA_VOL_1_IOPS="6000"
DATA_VOL_1_THROUGHPUT="500"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
SNAPSHOT_ENABLED="false"
# Default: latest pruned snapshot via --init.latest=pruned. To pin one, use the
# DIRECTORY URL (trailing slash) from
# https://snapshot-explorer.arbitrum.io/?chain=Arbitrum+Nova
# ARBITRUM_SNAPSHOT_URL="https://snapshot.arbitrum.foundation/nova/<YYYY-MM-DD-id>/"

# Arbitrum Custom Configuration
# Ethereum MAINNET L1 endpoints (Nova settles to Ethereum mainnet). Batch data
# comes from Nova's AnyTrust DAS mirrors, which Nitro configures itself from
# its built-in chain info. Free, no-key defaults. The RPC must serve
# eth_getLogs for L1 blocks back to the snapshot's date (Nova's newest
# snapshot can be a month old). publicnode's free RPC refuses that ("Archive
# requests require a personal token"), so it is NOT usable here. Free, keyless
# alternative that serves old logs: https://rpc.mevblocker.io
ARBITRUM_L1_RPC_URL="https://mainnet.gateway.tenderly.co"
ARBITRUM_L1_BEACON_URL="https://ethereum-beacon-api.publicnode.com"

# Node ports (optional - defaults shown)
# ARBITRUM_RPC_PORT="8547"
# ARBITRUM_WS_PORT="8548"
# ARBITRUM_METRICS_PORT="6070"
