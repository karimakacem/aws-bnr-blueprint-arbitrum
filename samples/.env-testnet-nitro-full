##############################################################
# Arbitrum Sepolia - Arbitrum Nitro (Full Node)
# Chain ID 421614 - settles to Ethereum Sepolia
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Availability Zone (optional - override automatic AZ selection for single-node deployments)
# AWS_AZ="us-east-1a"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="arbitrum"
DEPLOYMENT_MODE="single-node"
BC_NETWORK="testnet"
CLIENT_CONFIG="nitro-v3.12.1-full.yml"

# Instance Configuration
# r6i.2xlarge: 8 vCPU, 64 GB RAM (Arbitrum docs' full-node minimum).
# Arbitrum Sepolia carries heavy test traffic; its state is not small.
INSTANCE_TYPE="r6i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
# The 2026-10-02 pruned snapshot is 1,913,617,571,840 bytes (1782 GiB, 4 parts)
# and grew ~144 GiB in the 11 days since the 09-21 snapshot. 2x for the
# restore = 3564 GiB today; 4500 GiB covers ~a month of snapshot growth.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="4500"
DATA_VOL_1_IOPS="16000"
DATA_VOL_1_THROUGHPUT="1000"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
SNAPSHOT_ENABLED="false"
# Default: latest pruned snapshot via --init.latest=pruned. To pin one, use the
# DIRECTORY URL (trailing slash) from
# https://snapshot-explorer.arbitrum.io/?chain=Arbitrum+Sepolia
# ARBITRUM_SNAPSHOT_URL="https://snapshot.arbitrum.foundation/sepolia-rollup/<YYYY-MM-DD-id>/"

# Arbitrum Custom Configuration
# Ethereum SEPOLIA L1 endpoints (execution RPC + beacon), free and keyless.
# Nitro fetches batch blobs itself from <beacon>/eth/v1/beacon/blobs/{slot},
# so the beacon must serve that endpoint (publicnode's Sepolia beacon does).
# A beacon keeps blobs ~18 days; the latest snapshot is normally younger.
#
# Execution RPC: it must serve eth_getLogs for L1 blocks back to the
# snapshot's date, because Nitro replays the inbox from there after a restore.
# Tested from EC2: publicnode's Sepolia RPC returns "pruned history
# unavailable" for older ranges, and onFinality's free endpoint returned 429
# on every request. Tenderly's keyless public gateway served 2000-block
# getLogs ranges 12 days back without errors.
ARBITRUM_L1_RPC_URL="https://sepolia.gateway.tenderly.co"
ARBITRUM_L1_BEACON_URL="https://ethereum-sepolia-beacon-api.publicnode.com"

# Node ports (optional - defaults shown)
# ARBITRUM_RPC_PORT="8547"
# ARBITRUM_WS_PORT="8548"
# ARBITRUM_METRICS_PORT="6070"
