##############################################################
# Arbitrum One - Arbitrum Nitro (Full Node, HA)
# Chain ID 42161 - settles to Ethereum mainnet
##############################################################

# AWS Configuration
AWS_ACCOUNT_ID="xxxxxxxxxxx"
AWS_REGION="us-east-1"

# Protocol Configuration
BLOCKCHAIN_PROTOCOL="arbitrum"
DEPLOYMENT_MODE="ha-nodes"
BC_NETWORK="mainnet"
CLIENT_CONFIG="nitro-v3.12.1-full.yml"

# Instance Configuration
# r6i.2xlarge: 8 vCPU, 64 GB RAM (Arbitrum docs' full-node minimum).
INSTANCE_TYPE="r6i.2xlarge"
CPU_TYPE="x86_64"

# Storage Configuration
# ~2x the 2485 GiB pruned snapshot (2026-10-05) + growth headroom. See
# .env-mainnet-nitro-full and the README "Database Snapshots" section.
DATA_VOLUMES_COUNT="1"
DATA_VOL_1_TYPE="gp3"
DATA_VOL_1_SIZE="5500"
DATA_VOL_1_IOPS="16000"
DATA_VOL_1_THROUGHPUT="1000"
DATA_VOL_1_MOUNT_PATH="/data"
DATA_VOL_1_FILESYSTEM="ext4"

# Snapshot Configuration
SNAPSHOT_ENABLED="false"
# Each node restores the latest pruned snapshot (--init.latest=pruned) on
# first start. To pin one, set the snapshot DIRECTORY URL (trailing slash):
# ARBITRUM_SNAPSHOT_URL="https://snapshot.arbitrum.foundation/arb1/<YYYY-MM-DD-id>/"

# HA Configuration
HA_NUMBER_OF_NODES="2"
HA_ALB_HEALTHCHECK_PORT="8547"
HA_ALB_HEALTHCHECK_PATH="/"
# A Nitro node answers a plain GET / on the RPC port with HTTP 400 (it expects
# a JSON-RPC POST). A 400 therefore means the node is up and serving, so accept
# it alongside 200 - otherwise the ALB marks every node unhealthy (default is
# "200") and the ASG replaces them in a loop.
HA_ALB_HEALTHCHECK_HTTP_CODES="200,400"
# The RPC port only opens after the snapshot restore (download ~2.5 TB, join,
# extract), which can take longer than this grace period. If the ASG starts
# replacing a node that is still restoring, suspend ReplaceUnhealthy until it
# is serving - see README "Troubleshooting".
HA_ALB_HEALTHCHECK_GRACE_PERIOD_MIN="300"
HA_ALB_HEALTHCHECK_INTERVAL_SEC="30"
HA_ALB_HEALTHCHECK_TIMEOUT_SEC="10"
HA_ALB_HEALTHCHECK_HEALTHY_THRESHOLD="2"
HA_ALB_HEALTHCHECK_UNHEALTHY_THRESHOLD="3"
HA_NODES_HEARTBEAT_DELAY_MIN="60"
HA_ALB_DEREGISTRATION_DELAY_SEC="60"

# Arbitrum Custom Configuration
# Ethereum MAINNET L1 endpoints (execution RPC + beacon). Free, no-key
# defaults; the node tolerates free-endpoint rate limits during catch-up (see
# node.sh). The RPC must serve eth_getLogs for L1 blocks back to the
# snapshot's date: after a restore, Nitro replays the inbox from there.
# publicnode's free RPC refuses that ("Archive requests require a personal
# token"), so it is NOT usable here. Free, keyless alternative that serves old
# logs: https://rpc.mevblocker.io
ARBITRUM_L1_RPC_URL="https://mainnet.gateway.tenderly.co"
ARBITRUM_L1_BEACON_URL="https://ethereum-beacon-api.publicnode.com"

# ALB Exposure (security)
# By default the load balancer is INTERNAL (reachable only inside the VPC) and
# ingress is restricted to the VPC CIDR. To expose the RPC endpoint beyond the
# VPC, uncomment and set the following:
# HA_ALB_INTERNET_FACING="true"          # expose the ALB to the internet (use with caution)
# HA_ALB_ALLOWED_CIDR="203.0.113.0/24"   # REQUIRED when internet-facing: restrict to trusted source IPs
# HA_ALB_CERTIFICATE_ARN="arn:aws:acm:REGION:ACCOUNT:certificate/ID"  # enable HTTPS (TLS terminated at the ALB)
